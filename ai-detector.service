[Unit]
Description=AI-text detector (OR ensemble of three DeBERTa classifiers)
After=network.target

[Service]
# adjust WorkingDirectory and ExecStart to your checkout
WorkingDirectory=/opt/ai-detector
ExecStart=/opt/ai-detector/.venv/bin/python server.py
Environment=AIDET_HOST=127.0.0.1 AIDET_PORT=8790 AIDET_IDLE_MIN=15 TOKENIZERS_PARALLELISM=false
Restart=on-failure

[Install]
WantedBy=multi-user.target
